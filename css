/* ==========================================================================
   MEMENTO — CONDENSED SERIF & OLIVE SAGE EDITORIAL STYLESHEET
   ========================================================================== */

:root {
    /* Exact Colour Scheme from your Mockup */
    --bar-charcoal: #474745;        /* Top navigation bar */
    --bg-olive: #b3b98c;            /* Signature olive-sage field */
    --text-olive: #959e6d;          /* Olive-sage display title & nav links */
    --placeholder-dark: #54594c;    /* Soft film-toned placeholder backdrop */
    --bg-linen: #f5f2eb;            /* Warm cream/linen contrast sections */
    --bg-cream: #fbf9f4;            /* Card frame surface */
    --bg-blush: #eadcd6;            /* Soft dusty blush accent */

    --ink-dark: #252420;            /* Deep charcoal/black for subtitles & body */
    --ink-muted: #525048;
    --border-hairline: rgba(37, 36, 32, 0.18);

    /* Condensed Serif Font Stack */
    --font-condensed: 'Times New Roman MT Condensed', 'TimesNewRomanMTStd-Cond', 'Times New Roman', Times, serif;
}

/* Reset */
*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

body {
    background-color: var(--bg-olive);
    color: var(--ink-dark);
    font-family: var(--font-condensed);
    font-stretch: condensed;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
}

/* ==========================================================================
   GLOBAL LINK RULE — Everything underlined is a real link
   ========================================================================== */

a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    transition: opacity 0.25s ease, color 0.25s ease;
}

a:hover {
    opacity: 0.72;
}

/* ==========================================================================
   TOP CHARCOAL NAVBAR (.navbar)
   ========================================================================== */

.navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--bar-charcoal);
    padding: 1.1rem 6%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.navbar nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(2.2rem, 7vw, 6.5rem);
}

.navbar nav a {
    font-family: var(--font-condensed);
    font-stretch: condensed;
    font-size: 1.05rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-olive);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
}

.navbar nav a:hover {
    color: #cfd5aa;
    opacity: 1;
}

/* ==========================================================================
   HERO SECTION (.hero) — Full-Bleed Photo Placeholder + Olive Lower Band
   ========================================================================== */

.hero {
    background-color: var(--bg-olive);
    border-bottom: 1px solid var(--border-hairline);
}

/* Wide horizontal photo placeholder matching the mockup proportions */
.hero-photo-placeholder {
    position: relative;
    width: 100%;
    height: clamp(280px, 46vh, 450px);
    background:
        radial-gradient(circle at 55% 58%, rgba(235, 224, 218, 0.26) 0%, transparent 55%),
        linear-gradient(to bottom, rgba(45, 48, 39, 0.35), rgba(45, 48, 39, 0.2)),
        var(--placeholder-dark);
    /* When you have your own photo, replace the background above with:
       background: url('your-photo.jpg') center / cover no-repeat; */
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    text-align: center;
    padding: 0 5% 1.1rem;
    overflow: hidden;
}

/* Subtle placeholder label in top-right corner (remove once you add your photo) */
.hero-photo-placeholder::after {
    content: 'HERO PHOTO PLACEHOLDER';
    position: absolute;
    top: 14px;
    right: 18px;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: rgba(251, 249, 244, 0.45);
}

.hero-title-group {
    position: relative;
    z-index: 2;
    transform: translateY(4px);
}

.hero h1 {
    font-family: var(--font-condensed);
    font-stretch: condensed;
    font-weight: 400;
    font-size: clamp(4.2rem, 10.5vw, 7.8rem);
    line-height: 0.88;
    letter-spacing: -0.02em;
    color: var(--text-olive);
    text-shadow: 0 2px 14px rgba(25, 25, 22, 0.35);
    margin-bottom: 0.35rem;
}

.hero-subtitle {
    font-family: var(--font-condensed);
    font-stretch: condensed;
    font-size: clamp(0.88rem, 1.4vw, 1.05rem);
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-dark);
}

/* Olive-sage lower band with centered underlined link */
.hero-lower {
    background-color: var(--bg-olive);
    padding: clamp(3.2rem, 6vw, 4.8rem) 6%;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}

.discover {
    font-family: var(--font-condensed);
    font-stretch: condensed;
    font-size: 1.02rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-dark);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
}

/* ==========================================================================
   CONTENT SECTIONS (.introduction, .portfolio, .about, .contact)
   ========================================================================== */

main > section:not(.hero) {
    padding: clamp(4.5rem, 8vw, 7rem) 6%;
}

.eyebrow {
    font-size: 0.85rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.75rem;
}

h2 {
    font-family: var(--font-condensed);
    font-stretch: condensed;
    font-weight: 400;
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    line-height: 1.1;
    color: var(--ink-dark);
    margin-bottom: 1.1rem;
}

main > section:not(.hero) p:not(.eyebrow) {
    font-size: 1.2rem;
    color: var(--ink-muted);
    max-width: 48ch;
}

/* Introduction */
.introduction {
    background-color: var(--bg-linen);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-bottom: 1px solid var(--border-hairline);
}

/* Portfolio */
.portfolio {
    background-color: var(--bg-olive);
    border-bottom: 1px solid var(--border-hairline);
}

.portfolio > .eyebrow,
.portfolio > h2 {
    max-width: 1220px;
    margin-inline: auto;
    text-align: center;
}

.portfolio > h2 {
    margin-bottom: 2.5rem;
}

.gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    max-width: 1220px;
    margin-inline: auto;
}

/* Gallery photo placeholders (clicking opens/links to each category) */
.photo-placeholder {
    position: relative;
    aspect-ratio: 4 / 5;
    background-color: var(--bg-cream);
    border: 1px solid var(--border-hairline);
    padding: 1rem;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    text-decoration: none; /* Card itself isn't underlined, only the h3 text inside */
    transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.photo-placeholder::before {
    content: 'PHOTO PLACEHOLDER';
    position: absolute;
    inset: 12px 12px 46px 12px;
    background-color: var(--placeholder-dark);
    color: rgba(251, 249, 244, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    letter-spacing: 0.22em;
}

.photo-placeholder:nth-child(2)::before {
    background-color: #636756;
}

.photo-placeholder:nth-child(3)::before {
    background-color: #4c4f44;
}

.photo-placeholder:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px rgba(37, 36, 32, 0.12);
    opacity: 1;
}

.photo-placeholder h3 {
    position: relative;
    z-index: 1;
    font-family: var(--font-condensed);
    font-stretch: condensed;
    font-weight: 400;
    font-size: 0.95rem;
    letter-spacing: 0.22em;
    color: var(--ink-dark);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
}

/* About */
.about {
    background-color: var(--bg-linen);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-bottom: 1px solid var(--border-hairline);
}

/* Contact */
.contact {
    background-color: var(--bg-blush);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-bottom: 1px solid var(--border-hairline);
}

/* ==========================================================================
   FOOTER
   ========================================================================== */

footer {
    background-color: var(--bar-charcoal);
    padding: 1.6rem 6%;
    text-align: center;
}

footer p a {
    font-size: 0.85rem;
    letter-spacing: 0.24em;
    color: var(--text-olive);
    text-decoration: underline;
    text-underline-offset: 4px;
}

/* ==========================================================================
   RESPONSIVE
   ========================================================================== */

@media (max-width: 900px) {
    .gallery {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {
    .navbar nav {
        gap: 1.6rem;
    }

    .navbar nav a {
        font-size: 0.92rem;
        letter-spacing: 0.16em;
    }

    .gallery {
        grid-template-columns: 1fr;
    }
}
